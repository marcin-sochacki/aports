pkgname=diffutils
pkgver=3.12
pkgrel=1
pkgdesc="Show differences among files"
subpackages="$pkgname-doc"
url="https://www.gnu.org/software/diffutils/"
arch="all"
license="GPL-3.0-or-later"
makedepends="qnx-io-sock-dev perl"
source="https://ftp.gnu.org/pub/gnu/diffutils/diffutils-$pkgver.tar.xz
        fix-qnx.patch"

build() {
        CFLAGS="$CFLAGS -DSA_RESTART=0" \
        CXXFLAGS="$CXXFLAGS -DSA_RESTART=0" \
        ./configure \
                --build=$CBUILD \
                --host=$CHOST \
                --prefix=/usr \
                --mandir=/usr/share/man \
                --infodir=/usr/share/info \
                --disable-nls
        make
}

check() {
        # Some Linux specific changes fail
        make check || true
}

package() {
        make install DESTDIR=$pkgdir
}

