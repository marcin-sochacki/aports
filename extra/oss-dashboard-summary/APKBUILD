pkgname=oss-dashboard-summary
pkgver=0.1
pkgrel=0
pkgdesc="Grab the dashboard summary info for QNX"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
source="oss-dashboard-summary.c"

build() {
    gcc oss-dashboard-summary.c -O2 -o oss-dashboard-summary -lcurl
}

package() {
    mkdir -p "$pkgdir"/usr/bin
    install -v -m755 $srcdir/oss-dashboard-summary "$pkgdir"/usr/bin
}

