# Contributor: Marcin Sochacki <msochacki@qnx.com>
# Maintainer: Marcin Sochacki <msochacki@qnx.com>
pkgname=pistache
pkgver=0.4.26
pkgrel=0
pkgdesc="A high-performance REST toolkit written in C++"
url="https://pistacheio.github.io/pistache/"
arch="all"
license="Apache-2.0"
depends="libc++ libevent qnx-io-sock"
depends_dev="
	libc++-dev
	libevent-dev
	qnx-io-sock-dev
	rapidjson-dev
	"
makedepends="$depends_dev meson"
checkdepends="curl-dev gmock gtest-dev"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/pistache/archive/refs/tags/qnx-v$pkgver-1.tar.gz
	pkgconf_version_string.patch
	"
builddir="$srcdir/$pkgname-qnx-v$pkgver-1"

# The BSD socket API lives in libsocket on QNX, and pistache's meson.build
# does not link it; without it the link fails on setsockopt, bind, listen.
build() {
	export LDFLAGS="$LDFLAGS -lsocket"
	abuild-meson \
		-DPISTACHE_BUILD_TESTS="$(want_check && echo true || echo false)" \
		. output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

