pkgname=wayland-protocols
pkgver=1.45
pkgrel=1
pkgdesc="Protocols and protocol extensions complementing the Wayland core protocol"
url="https://wayland.freedesktop.org"
arch="noarch"
license="MIT"
provides="$pkgname-dev=$pkgver-r$pkgrel"
makedepends="meson ninja pkgconf pkgconf-dev wayland-dev clang libc++-dev"
source="https://gitlab.freedesktop.org/wayland/wayland-protocols/-/archive/$pkgver/wayland-protocols-$pkgver.tar.gz"

build() {
    CC="clang -Wno-unused-command-line-argument -Werror" \
    CXX="clang++ -Wno-unused-command-line-argument -Werror" \
    abuild-meson -Dtests=true . build
    ninja -C build
}

check() {
    meson test --print-errorlogs -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

sha512sums="
