# Alpine-Maintainer: Alex McGrath <amk@amk.ie>
# Maintainer: Aaron Bassett <abassett@qnx.com>
# NOTE: this compiles but is having issues rendering on weston 
# and need to figure out pty control issues
pkgname=foot
pkgver=1.23.1
pkgrel=0
pkgdesc="Fast, lightweight and minimalistic Wayland terminal emulator"
url="https://codeberg.org/dnkl/foot"
license="MIT"
arch="all"
depends="ncurses-terminfo fcft fontconfig pixman utf8proc wayland libxkbcommon qnx-fs-notify qnx-io-sock "
#TODO: add cage back to re-enable PGO
makedepends="
	fcft-dev
	fontconfig-dev
	freetype-dev
	libxkbcommon-dev
	meson
	ncurses
	pixman-dev
	scdoc
	tllist-dev
	utf8proc-dev
	wayland-dev
	wayland-protocols
	qnx-fd-notify-dev
	qnx-io-sock-dev
	"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-fish-completion
	$pkgname-zsh-completion
	$pkgname-extra-terminfo:_extra_terminfo:noarch
	$pkgname-themes:_themes:noarch
	"
source="
	$pkgname-$pkgver.tar.gz::https://codeberg.org/dnkl/foot/archive/$pkgver.tar.gz
	qnx_fix.patch
	input-event-codes.h
	"
options="!check" # ran during profiling
builddir="$srcdir/foot"

prepare() {
    default_prepare

    mkdir -p linux
    mkdir -p tests/linux

    cp "$srcdir"/input-event-codes.h linux
    cp "$srcdir"/input-event-codes.h tests/linux/input-event-codes.h
}

build() {
	export CFLAGS="$CFLAGS -O3" # -O3 as the package is intended to use it
	export CXXFLAGS="$CXXFLAGS -O3"
	export CPPFLAGS="$CPPFLAGS -O3"
        pwd
	meson setup \
		-Dprefix=/usr \
		-Db_pgo=off \
		-Db_lto=true \
		-Dterminfo-base-name=foot-extra \
		-Dc_link_args="-Wl,-lm,-lsocket,-lgcc_s -lregex -lepoll -ltimerfd -leventfd" \
		-Dutmp-backend=none \
		-Dbuildtype=plain \
		. output

	meson compile -C output
	ninja -C output test
	# Once we package cage we can run pgo but we stil have to compiler twice due to tests
	#./pgo/full-headless-cage.sh . output

	# once we get PGO back we can remove this tests as compiled in as constructors
	meson configure -Db_pgo=off -Dtests=false output
	meson compile -C output
}

check() {
    ninja -C output test
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

_extra_terminfo() {
	pkgdesc="$pkgdesc (extra terminfo data)"

	amove usr/share/terminfo/f
}

_themes() {
	pkgdesc="$pkgdesc (color schemes)"

	amove usr/share/foot/themes
}


