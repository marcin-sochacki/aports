source="https://github.com/qnx-ports/godot-QNX/archive/$_commit.tar.gz
        0001-godot-wayland-build-for-qnx.patch
        0002-openxr-library-fix.patch
        0003-do-not-force-gcc-for-llvm.patch
        0004-library-linking-fix.patch
        "
options="!check" # No tests
builddir="$startdir"/src/godot-QNX-"$_commit"
_sconsflags="
    module_camera_enabled=false
    builtin_brotli=false
    builtin_freetype=false
    builtin_graphite=false
    builtin_harfbuzz=false
    builtin_icu4c=false
    builtin_libogg=false
    builtin_libtheora=false
    builtin_libpng=false
    builtin_libvorbis=false
    builtin_libwebp=false
    builtin_opus=false
    builtin_pcre2=false
    builtin_zlib=false
    builtin_zstd=false
    engine_update_check=false
    execinfo=false
    x11=no
    wayland=no
